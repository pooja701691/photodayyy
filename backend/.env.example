PORT=5000
NODE_ENV=production

# Database (PostgreSQL - e.g., Neon.tech / Supabase / Render)
DATABASE_URL="postgresql://username:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Authentication
JWT_SECRET="your_strong_jwt_secret_key"

# Cloudinary (Media Storage)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Redis Configuration (Use REDIS_URL for Upstash/Render/Railway, OR Host/Port for local)
REDIS_URL="rediss://default:your_password@your-upstash-redis-url.upstash.io:6379"
# Or local:
# REDIS_HOST="localhost"
# REDIS_PORT=6379
# REDIS_PASSWORD=""

# Qdrant Vector Database (e.g., Qdrant Cloud cluster)
QDRANT_URL="https://your-cluster-url.eu-central.aws.cloud.qdrant.io:6333"
QDRANT_API_KEY="your_qdrant_api_key"
QDRANT_COLLECTION_NAME="photoday_faces"

