meta {
  name: Unauthorized Photo Deletion
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/photos/non-existent-or-foreign-photo-id
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("should deny unauthorized/not found photo deletion", function() {
    expect([403, 404]).to.include(res.getStatus());
  });
}
