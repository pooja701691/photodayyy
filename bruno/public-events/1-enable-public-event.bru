meta {
  name: Enable Public Event
  type: http
  seq: 1
}

patch {
  url: {{baseUrl}}/events/{{eventId}}/public
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "isPublic": true
  }
}

tests {
  test("should enable public access on event", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.isPublic).to.be.true;
  });
}
