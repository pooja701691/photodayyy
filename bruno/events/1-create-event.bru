meta {
  name: Create Event
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/events
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Summer Beach Gala",
    "date": "2026-11-15",
    "location": "Miami Beachfront",
    "description": "Annual ocean sunset photo shoot."
  }
}

script:post-response {
  if (res.getStatus() === 201 && res.getBody().data && res.getBody().data.id) {
    bru.setEnvVar("eventId", res.getBody().data.id);
  }
}

tests {
  test("should create event successfully", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().success).to.be.true;
    expect(res.getBody().data.name).to.equal("Summer Beach Gala");
    expect(res.getBody().data.isPublic).to.be.false;
  });
}
