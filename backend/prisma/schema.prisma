datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("PHOTOGRAPHER")
  createdAt DateTime @default(now())
  events    Event[]

  @@map("users")
}

model Event {
  id             String   @id @default(uuid())
  name           String
  date           DateTime
  location       String
  description    String?
  isPublic       Boolean  @default(false)
  photographerId String
  photographer   User     @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  photos         Photo[]
  createdAt      DateTime @default(now())

  @@map("events")
}

enum AiProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  NO_FACE
  FAILED
}

model Photo {
  id                 String             @id @default(uuid())
  eventId            String
  event              Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  imageUrl           String
  cloudinaryPublicId String
  aiStatus           AiProcessingStatus @default(PENDING)
  facesCount         Int                @default(0)
  aiError            String?
  processedAt        DateTime?
  faceEmbeddings     FaceEmbedding[]
  createdAt          DateTime           @default(now())

  @@map("photos")
}

model FaceEmbedding {
  id            String   @id @default(uuid())
  photoId       String
  photo         Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  qdrantPointId String   @unique
  faceIndex     Int
  boxX          Float?
  boxY          Float?
  boxWidth      Float?
  boxHeight     Float?
  confidence    Float?
  createdAt     DateTime @default(now())

  @@map("face_embeddings")
}

