meta {
  name: Get Photographer Events
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/events
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("should get photographer events list", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
    expect(res.getBody().data).to.be.an('array');
  });
}
