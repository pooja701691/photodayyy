meta {
  name: Register Photographer
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Alex Photographer",
    "email": "alex.lens@example.com",
    "password": "Password123"
  }
}

tests {
  test("should register photographer successfully", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().success).to.be.true;
    expect(res.getBody().data.email).to.equal("alex.lens@example.com");
  });
}
